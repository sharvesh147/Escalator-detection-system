    {
      "cell_type": "code",
      "source": [
        "def process_video(video_path, zone_polygon, output_prefix,\n",
        "                   conf_threshold=0.35,\n",
        "                   low_thresh=4, medium_thresh=7, high_thresh=10,\n",
        "                   dwell_frames=15, smoothing_window=5):\n",
        "    \"\"\"\n",
        "    conf_threshold: YOLO confidence cutoff. Lower = catches more people but\n",
        "                    more false positives. 0.35 is a good middle ground for crowds.\n",
        "    low/medium/high_thresh: person-count bands used to classify congestion level.\n",
        "    dwell_frames: how many consecutive frames count must stay >= high_thresh\n",
        "                  before an ALERT event is logged (avoids one noisy frame\n",
        "                  triggering a false alert).\n",
        "    smoothing_window: rolling average window over recent frame counts, to stop\n",
        "                       the on-screen number/level from flickering frame-to-frame.\n",
        "    \"\"\"\n",
        "    zone = sv.PolygonZone(polygon=zone_polygon)\n",
        "    zone_annotator = sv.PolygonZoneAnnotator(zone=zone, thickness=2, color=sv.Color.RED)\n",
        "    tracker = sv.ByteTrack()\n",
        "\n",
        "    cap = cv2.VideoCapture(video_path)\n",
        "    fps = cap.get(cv2.CAP_PROP_FPS) or 25\n",
        "    w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
        "    h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
        "\n",
        "    out = cv2.VideoWriter(f\"{output_prefix}_annotated.mp4\",\n",
        "                           cv2.VideoWriter_fourcc(*\"mp4v\"), fps, (w, h))\n",
        "    snap_dir = f\"{output_prefix}_snapshots\"\n",
        "    os.makedirs(snap_dir, exist_ok=True)\n",
        "\n",
        "    events = []\n",
        "    recent_counts = []\n",
        "    consecutive_high = 0\n",
        "    alert_active = False\n",
        "    frame_idx = 0\n",
        "\n",
        "    while True:\n",
        "        ret, frame = cap.read()\n",
        "        if not ret:\n",
        "            break\n",
        "\n",
        "        results = model(frame, classes=[0], conf=conf_threshold, verbose=False)[0]\n",
        "        detections = sv.Detections.from_ultralytics(results)\n",
        "        detections = tracker.update_with_detections(detections)\n",
        "\n",
        "        in_zone_mask = zone.trigger(detections)\n",
        "        raw_count = int(in_zone_mask.sum())\n",
        "\n",
        "        # Smooth the count so the displayed number/level doesn't flicker\n",
        "        recent_counts.append(raw_count)\n",
        "        if len(recent_counts) > smoothing_window:\n",
        "            recent_counts.pop(0)\n",
        "        smoothed_count = round(sum(recent_counts) / len(recent_counts))\n",
        "\n",
        "        # Congestion level classification\n",
        "        if smoothed_count >= high_thresh:\n",
        "            level, color = \"HIGH\", (0, 0, 255)\n",
        "        elif smoothed_count >= medium_thresh:\n",
        "            level, color = \"MEDIUM\", (0, 165, 255)\n",
        "        elif smoothed_count >= low_thresh:\n",
        "            level, color = \"LOW\", (0, 255, 255)\n",
        "        else:\n",
        "            level, color = \"NORMAL\", (0, 200, 0)\n",
        "\n",
        "        annotated = box_annotator.annotate(frame.copy(), detections[in_zone_mask])\n",
        "        annotated = label_annotator.annotate(annotated, detections[in_zone_mask])\n",
        "        annotated = zone_annotator.annotate(annotated)\n",
        "\n",
        "        cv2.putText(annotated, f\"People in zone: {smoothed_count}\", (20, 40),\n",
        "                    cv2.FONT_HERSHEY_SIMPLEX, 1, (255, 255, 255), 2)\n",
        "        cv2.putText(annotated, f\"Congestion: {level}\", (20, 80),\n",
        "                    cv2.FONT_HERSHEY_SIMPLEX, 1, color, 2)\n",
        "\n",
        "        # Alert logic — sustained HIGH congestion, not a one-frame spike\n",
        "        if level == \"HIGH\":\n",
        "            consecutive_high += 1\n",
        "        else:\n",
        "            consecutive_high = 0\n",
        "            alert_active = False\n",
        "\n",
        "        if consecutive_high >= dwell_frames and not alert_active:\n",
        "            alert_active = True\n",
        "            timestamp = frame_idx / fps\n",
        "            snapshot_path = f\"{snap_dir}/alert_frame{frame_idx}.jpg\"\n",
        "            cv2.imwrite(snapshot_path, annotated)\n",
        "            events.append({\n",
        "                \"event_id\": len(events) + 1,\n",
        "                \"frame\": frame_idx,\n",
        "                \"timestamp_sec\": round(timestamp, 2),\n",
        "                \"people_count\": smoothed_count,\n",
        "                \"congestion_level\": level,\n",
        "                \"snapshot_path\": snapshot_path,\n",
        "                \"detected_at\": datetime.now().isoformat(),\n",
        "            })\n",
        "            cv2.putText(annotated, \"ALERT: OVERCROWDING\", (20, 120),\n",
        "                        cv2.FONT_HERSHEY_SIMPLEX, 1.1, (0, 0, 255), 3)\n",
        "\n",
        "        out.write(annotated)\n",
        "        frame_idx += 1\n",
        "\n",
        "    cap.release()\n",
        "    out.release()\n",
        "\n",
        "    # Text report\n",
        "    with open(f\"{output_prefix}_report.txt\", \"w\") as f:\n",
        "        f.write(f\"CONGESTION REPORT — {output_prefix}\\n\")\n",
        "        f.write(\"=\" * 55 + \"\\n\\n\")\n",
        "        f.write(f\"Total frames processed: {frame_idx}\\n\")\n",
        "        f.write(f\"Video FPS: {fps}\\n\")\n",
        "        f.write(f\"Total congestion events (sustained HIGH): {len(events)}\\n\\n\")\n",
        "        if not events:\n",
        "            f.write(\"No sustained overcrowding events detected.\\n\")\n",
        "        for e in events:\n",
        "            f.write(f\"Event #{e['event_id']}\\n\")\n",
        "            f.write(f\"  Frame: {e['frame']}\\n\")\n",
        "            f.write(f\"  Timestamp: {e['timestamp_sec']} sec\\n\")\n",
        "            f.write(f\"  People count: {e['people_count']}\\n\")\n",
        "            f.write(f\"  Congestion level: {e['congestion_level']}\\n\")\n",
        "            f.write(f\"  Snapshot: {e['snapshot_path']}\\n\")\n",
        "            f.write(f\"  Logged at: {e['detected_at']}\\n\")\n",
        "            f.write(\"-\" * 55 + \"\\n\")\n",
        "\n",
        "    print(f\"[{output_prefix}] done — {len(events)} congestion event(s). \"\n",
        "          f\"Video: {output_prefix}_annotated.mp4 | Report: {output_prefix}_report.txt\")\n",
        "    return events\n"
      ],
