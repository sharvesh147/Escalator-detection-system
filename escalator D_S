        "\n",
        "def full_frame_zone(video_path, margin_ratio=0.05):\n",
        "    \"\"\"Creates a zone covering ~90% of the frame (small margin trimmed off\n",
        "    the edges so people just walking past outside the escalator area aren't counted).\"\"\"\n",
        "    cap = cv2.VideoCapture(video_path)\n",
        "    ret, frame = cap.read()\n",
        "    h, w = frame.shape[:2]\n",
        "    cap.release()\n",
        "    mx, my = int(w * margin_ratio), int(h * margin_ratio)\n",
        "    return np.array([\n",
        "        [mx, my],\n",
        "        [w - mx, my],\n",
        "        [w - mx, h - my],\n",
        "        [mx, h - my],\n",
        "    ])\n",
        "\n",
        "zone_polygons = {\n",
        "    \"sample1\": full_frame_zone(\"sample1.mp4\"),\n",
        "    \"sample2\": full_frame_zone(\"sample2.mp4\"),\n",
        "    \"sample3\": full_frame_zone(\"sample3.mp4\"),\n",
        "}\n",
        "\n",
        "print(\"Zones set automatically for all 3 videos.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
